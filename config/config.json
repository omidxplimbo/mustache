{
  "appName": "mustache",
  "dbPrefix": "mustache_",
  "dbTimeout": 100000,
  "logAddress": "/tmp/mustache/logs",
  "mongoUrl": "mongodb://localhost:27017",
  "addresses": {
    "binary": "mustache/binary"
  },
  "collections": [
    "subdomain",
    "domain",
    "cidr",
    "asn",
    "urls",
    "parameters",
    "wordlist",
    "screenshot"
  ],
  "publicErrors": {
    "errorConnectDb": "Connect to database with error. See logs",
    "subdomainAddToDatabase": "Subdomain add to database"
  }
}